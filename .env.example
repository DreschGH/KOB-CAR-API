# Configurações da API KOB CAR

# Credenciais de acesso
KOB_API_USER=seu_usuario@empresa.com.br
KOB_API_PASSWORD=sua_senha_segura

# URL base da API
KOB_API_BASE_URL=https://api.kob.tech

# CNPJ do vendedor (sem formatação, apenas números)
KOB_CNPJ_VENDEDOR=00000000000000

# Configurações opcionais
KOB_API_TIMEOUT=30
KOB_LOG_LEVEL=INFO
KOB_DATA_DIR=./data
KOB_LOG_DIR=./logs
VENDAS_PATH=path_baseinterna_vendas

